generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  MERCHANT
  MEMBER
}

enum AccountStatus {
  ACTIVE
  PENDING_APPROVAL
  REJECTED
  SUSPENDED
  BANNED
}

enum AdminAuditAction {
  USER_STATUS_CHANGED
  EMAIL_BLACKLISTED
  EMAIL_BLACKLIST_DEACTIVATED
  MERCHANT_STATUS_CHANGED
}

enum AdminAuditTargetType {
  USER
  EMAIL_BLACKLIST
  MERCHANT
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  ACTIVE
  HIDDEN
}

enum ProductKind {
  SALE
  REWARD
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum RefundStatus {
  PENDING_PROVIDER
  COMPLETED
  FAILED
}

enum PaymentAttemptStatus {
  CREATED
  SUCCEEDED
  FAILED
}

enum TierLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum PointTransactionType {
  EARN
  REDEEM_DISCOUNT
  REDEEM_REWARD
  EARN_REVERSAL
  REDEMPTION_REVERSAL
}

enum PointTransactionSource {
  MOCK_PAYMENT
  VNPAY_IPN
  MEMBER_REDEMPTION
  MERCHANT_REFUND
  MERCHANT_REWARD_CANCELLATION
  ADMIN_ADJUSTMENT
  LEGACY_BACKFILL
  SYSTEM
}

enum VoucherType {
  DISCOUNT
  REWARD
}

enum MemberVoucherStatus {
  AVAILABLE
  PENDING_FULFILLMENT
  USED
  FULFILLED
  CANCELLED
}

enum InventoryOwnerType {
  SALE_PRODUCT
  REWARD_PRODUCT
  DISCOUNT_VOUCHER
}

enum InventoryMovementType {
  INITIAL_STOCK
  MANUAL_IN
  MANUAL_OUT
  RETURN_IN
  ORDER_RESERVE
  ORDER_RELEASE
  SALE_OUT
  REWARD_RESERVE
  REWARD_CANCEL_RELEASE
  REWARD_FULFILL_OUT
  REWARD_LEGACY_RESERVE
  VOUCHER_REDEMPTION_OUT
  REDEMPTION_REVERSAL_IN
  LEGACY_BACKFILL
}

enum LoyaltyPolicyVersionSource {
  MERCHANT_PUBLISH
  LEGACY_BACKFILL
}

model User {
  id                   Int                   @id @default(autoincrement())
  email                String                @unique @db.VarChar(191)
  passwordHash         String                @db.VarChar(255)
  role                 UserRole
  accountStatus        AccountStatus         @default(ACTIVE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  application          MerchantApplication?  @relation("Applicant")
  reviewedApplications MerchantApplication[] @relation("Reviewer")
  merchant             Merchant?             @relation("MerchantOwner")
  memberships          MerchantMembership[]  @relation("MemberMemberships")
  orders               Order[]               @relation("MemberOrders")
  fulfilledRewards     RewardFulfillment[]   @relation("RewardFulfiller")
  cancelledRewards     RewardCancellation[]  @relation("RewardCanceller")
  refundsRequested     OrderRefund[]         @relation("RefundRequester")
  abuseReportsFiled    MerchantAbuseReport[] @relation("AbuseReportReporter")
  abuseReportsReceived MerchantAbuseReport[] @relation("AbuseReportMember")
  publishedLoyaltyPolicies LoyaltyPolicyVersion[] @relation("LoyaltyPolicyPublisher")
  inventoryMovements InventoryMovement[] @relation("InventoryMovementActor")
}

model EmailBlacklistEntry {
  id             Int      @id @default(autoincrement())
  email          String   @unique @db.VarChar(191)
  reason         String   @db.VarChar(255)
  isActive       Boolean  @default(true)
  lastActorId    Int
  lastActorEmail String   @db.VarChar(191)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, updatedAt])
}

model AdminAuditLog {
  id         Int                  @id @default(autoincrement())
  actorId    Int
  actorEmail String               @db.VarChar(191)
  action     AdminAuditAction
  targetType AdminAuditTargetType
  targetId   Int
  reason     String               @db.VarChar(255)
  before     Json?
  after      Json?
  createdAt  DateTime             @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
}

model MerchantAbuseReport {
  id         Int      @id @default(autoincrement())
  merchantId Int
  reporterId Int
  memberId   Int
  orderId    Int?
  reason     String   @db.Text
  createdAt  DateTime @default(now())
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  reporter   User     @relation("AbuseReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  member     User     @relation("AbuseReportMember", fields: [memberId], references: [id], onDelete: Restrict)
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([merchantId, createdAt])
  @@index([memberId, createdAt])
  @@index([orderId])
}

model MerchantApplication {
  id           Int               @id @default(autoincrement())
  applicantId  Int               @unique
  storeName    String            @db.VarChar(191)
  status       ApplicationStatus @default(PENDING)
  reviewedById Int?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  applicant    User              @relation("Applicant", fields: [applicantId], references: [id])
  reviewedBy   User?             @relation("Reviewer", fields: [reviewedById], references: [id])

  @@index([status])
}

model Merchant {
  id                 Int                  @id @default(autoincrement())
  ownerId            Int                  @unique
  name               String               @db.VarChar(191)
  slug               String               @unique @db.VarChar(191)
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  owner              User                 @relation("MerchantOwner", fields: [ownerId], references: [id])
  products           Product[]
  orders             Order[]
  memberships        MerchantMembership[]
  tiers              LoyaltyTier[]
  loyaltyRule        LoyaltyRule?
  voucherDefinitions VoucherDefinition[]
  abuseReports       MerchantAbuseReport[]
  policyVersions     LoyaltyPolicyVersion[]
  inventoryBalances InventoryBalance[]
  inventoryMovements InventoryMovement[]
}

model Product {
  id          Int           @id @default(autoincrement())
  merchantId  Int
  name        String        @db.VarChar(191)
  description String?       @db.Text
  price       Decimal       @db.Decimal(15, 0)
  imageUrl    String?       @db.VarChar(2048)
  status      ProductStatus @default(ACTIVE)
  kind        ProductKind   @default(SALE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  merchant    Merchant      @relation(fields: [merchantId], references: [id])
  orderItems  OrderItem[]
  rewardVoucherDefinitions VoucherDefinition[]
  rewardVoucherSnapshots MemberVoucher[] @relation("RewardProductSnapshot")
  inventoryBalance InventoryBalance?
  inventoryMovements InventoryMovement[] @relation("ProductInventoryMovements")

  @@index([merchantId, status])
}

model Order {
  id               Int               @id @default(autoincrement())
  merchantId       Int
  memberId         Int
  status           OrderStatus       @default(PENDING)
  subtotal         Decimal           @db.Decimal(15, 0)
  discountAmount   Decimal           @default(0) @db.Decimal(15, 0)
  total            Decimal           @db.Decimal(15, 0)
  voucherId        Int?
  earnedPointsExact Decimal?         @db.Decimal(38, 12)
  loyaltySnapshot  Json?
  loyaltyPolicyVersionId Int?
  stockReservedAt DateTime?
  stockReservedUntil DateTime?
  stockReleasedAt DateTime?
  paidAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  merchant         Merchant          @relation(fields: [merchantId], references: [id])
  member           User              @relation("MemberOrders", fields: [memberId], references: [id])
  voucher          MemberVoucher?    @relation("AppliedVoucher", fields: [voucherId], references: [id])
  items            OrderItem[]
  pointTransactions PointTransaction[]
  paymentAttempt   PaymentAttempt?
  voucherReservation OrderVoucherReservation?
  refund           OrderRefund?
  abuseReports     MerchantAbuseReport[]
  loyaltyPolicyVersion LoyaltyPolicyVersion? @relation(fields: [loyaltyPolicyVersionId], references: [id], onDelete: Restrict)
  inventoryMovements InventoryMovement[]

  @@index([merchantId, status])
  @@index([memberId, createdAt])
  @@index([voucherId])
  @@index([merchantId, status, stockReservedUntil])
  @@index([loyaltyPolicyVersionId])
}

model PaymentAttempt {
  id                    Int                  @id @default(autoincrement())
  orderId               Int                  @unique
  txnRef                String               @unique @db.VarChar(100)
  expectedAmount        Decimal              @db.Decimal(15, 0)
  reservedPoints        Decimal              @default(0) @db.Decimal(38, 12)
  snapshotTierLevel     TierLevel?
  snapshotMultiplier    Decimal?             @db.Decimal(5, 2)
  snapshotPolicy        Json?
  snapshotVndPerPoint   Int                  @default(10000)
  snapshotRuleActive    Boolean              @default(true)
  snapshotMaxMultiplier Decimal              @default(2.00) @db.Decimal(5, 2)
  snapshotTierConfigFallback Boolean         @default(false)
  snapshotExactReservationAward Boolean      @default(false)
  snapshotBronzeMultiplier   Decimal         @default(1.00) @db.Decimal(5, 2)
  snapshotSilverMultiplier   Decimal         @default(1.20) @db.Decimal(5, 2)
  snapshotGoldMultiplier     Decimal         @default(1.50) @db.Decimal(5, 2)
  snapshotPlatinumMultiplier Decimal         @default(2.00) @db.Decimal(5, 2)
  status                PaymentAttemptStatus @default(CREATED)
  transactionNo         String?              @db.VarChar(64)
  createdAt             DateTime             @default(now())
  confirmedAt           DateTime?
  order                 Order                @relation(fields: [orderId], references: [id])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   Int
  productName String  @db.VarChar(191)
  unitPrice   Decimal @db.Decimal(15, 0)
  quantity    Int
  lineTotal   Decimal @db.Decimal(15, 0)
  order       Order   @relation(fields: [orderId], references: [id])
  product     Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model MerchantMembership {
  id         Int             @id @default(autoincrement())
  merchantId Int
  memberId   Int
  tierId     Int?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  merchant   Merchant        @relation(fields: [merchantId], references: [id])
  member     User            @relation("MemberMemberships", fields: [memberId], references: [id])
  tier       LoyaltyTier?    @relation(fields: [tierId], references: [id])
  wallet     LoyaltyWallet?
  vouchers   MemberVoucher[]

  @@unique([memberId, merchantId])
  @@index([merchantId])
  @@index([tierId])
}

model LoyaltyTier {
  id                Int                  @id @default(autoincrement())
  merchantId        Int
  level             TierLevel
  minLifetimePoints Int
  multiplier        Decimal              @db.Decimal(5, 2)
  merchant          Merchant             @relation(fields: [merchantId], references: [id])
  memberships       MerchantMembership[]

  @@unique([merchantId, level])
  @@unique([merchantId, minLifetimePoints])
}

model LoyaltyRule {
  id          Int      @id @default(autoincrement())
  merchantId  Int      @unique
  vndPerPoint Int      @default(10000)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  merchant    Merchant @relation(fields: [merchantId], references: [id])
}

model LoyaltyPolicyVersion {
  id            Int                       @id @default(autoincrement())
  merchantId    Int
  version       Int
  vndPerPoint   Int
  isActive      Boolean
  tiers         Json
  source        LoyaltyPolicyVersionSource @default(MERCHANT_PUBLISH)
  publishedById Int?
  publishedAt   DateTime                  @default(now())
  merchant      Merchant                  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  publishedBy   User?                     @relation("LoyaltyPolicyPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  orders        Order[]

  @@unique([merchantId, version])
  @@index([merchantId, publishedAt])
  @@index([publishedById])
}

model LoyaltyWallet {
  id                   Int                @id @default(autoincrement())
  membershipId         Int                @unique
  exactBalance         Decimal            @default(0) @db.Decimal(38, 12)
  netLifetimeEarned    Decimal            @default(0) @db.Decimal(38, 12)
  reservedPoints       Decimal            @default(0) @db.Decimal(38, 12)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  membership           MerchantMembership @relation(fields: [membershipId], references: [id])
  transactions         PointTransaction[]
}

model PointTransaction {
  id              Int                    @id @default(autoincrement())
  walletId        Int
  type            PointTransactionType
  delta           Decimal                @db.Decimal(38, 12)
  balanceAfter    Decimal                @db.Decimal(38, 12)
  promotedToTier  TierLevel?
  reason          String                 @db.VarChar(255)
  eventRef        String                 @unique @default(uuid()) @db.VarChar(191)
  source          PointTransactionSource @default(LEGACY_BACKFILL)
  actorId         Int?
  orderId         Int?
  memberVoucherId Int?
  createdAt       DateTime               @default(now())
  wallet          LoyaltyWallet          @relation(fields: [walletId], references: [id])
  order           Order?                 @relation(fields: [orderId], references: [id])
  memberVoucher   MemberVoucher?         @relation(fields: [memberVoucherId], references: [id])

  @@index([walletId, createdAt])
  @@index([orderId])
  @@index([memberVoucherId])
  @@index([actorId])
}

model RedemptionIdempotency {
  id             Int      @id @default(autoincrement())
  memberId       Int
  route          String   @db.VarChar(191)
  idempotencyKey String   @db.VarChar(128)
  requestHash    String   @db.VarChar(64)
  definitionId   Int
  voucherId      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([memberId, route, idempotencyKey])
  @@index([memberId])
  @@index([voucherId])
}

model VoucherDefinition {
  id                Int             @id @default(autoincrement())
  merchantId        Int
  type              VoucherType
  title             String          @db.VarChar(191)
  pointsCost        Int
  discountAmount    Decimal?        @db.Decimal(15, 0)
  rewardDescription String?         @db.Text
  rewardProductId   Int?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  merchant          Merchant        @relation(fields: [merchantId], references: [id])
  rewardProduct     Product?        @relation(fields: [rewardProductId], references: [id], onDelete: Restrict)
  memberVouchers    MemberVoucher[]
  inventoryBalance InventoryBalance?
  inventoryMovements InventoryMovement[] @relation("VoucherInventoryMovements")

  @@index([merchantId, type, isActive])
  @@index([rewardProductId])
}

model MemberVoucher {
  id                        Int                 @id @default(autoincrement())
  membershipId              Int
  definitionId              Int
  snapshotType              VoucherType
  snapshotTitle             String              @db.VarChar(191)
  snapshotPointsCost        Int
  snapshotDiscountAmount    Decimal?            @db.Decimal(15, 0)
  snapshotRewardDescription String?             @db.Text
  rewardProductIdSnapshot   Int?
  rewardInventoryReserved   Boolean             @default(false)
  status                    MemberVoucherStatus @default(AVAILABLE)
  redeemedAt                DateTime            @default(now())
  usedAt                    DateTime?
  membership                MerchantMembership  @relation(fields: [membershipId], references: [id])
  definition                VoucherDefinition   @relation(fields: [definitionId], references: [id])
  appliedOrders             Order[]             @relation("AppliedVoucher")
  activeReservation         OrderVoucherReservation?
  pointTransactions         PointTransaction[]
  fulfillment               RewardFulfillment?
  cancellation              RewardCancellation?
  rewardProduct             Product?             @relation("RewardProductSnapshot", fields: [rewardProductIdSnapshot], references: [id], onDelete: Restrict)
  inventoryMovements        InventoryMovement[]

  @@index([membershipId, status])
  @@index([definitionId])
}

model InventoryBalance {
  id                  Int                @id @default(autoincrement())
  merchantId          Int
  ownerType           InventoryOwnerType
  productId           Int?               @unique
  voucherDefinitionId Int?               @unique
  onHandQuantity      Int                @default(0)
  reservedQuantity    Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  merchant            Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  product             Product?           @relation(fields: [productId], references: [id], onDelete: Restrict)
  voucherDefinition   VoucherDefinition? @relation(fields: [voucherDefinitionId], references: [id], onDelete: Restrict)
  movements           InventoryMovement[]

  @@index([merchantId, ownerType])
}

model InventoryMovement {
  id                  Int                  @id @default(autoincrement())
  balanceId           Int
  merchantId          Int
  ownerType           InventoryOwnerType
  movementType        InventoryMovementType
  quantityDelta       Int
  onHandBefore        Int
  onHandAfter         Int
  reservedBefore      Int
  reservedAfter       Int
  productId           Int?
  voucherDefinitionId Int?
  orderId             Int?
  memberVoucherId     Int?
  actorId             Int?
  reason              String               @db.VarChar(255)
  eventRef            String               @unique @db.VarChar(191)
  requestKey          String?              @db.VarChar(128)
  createdAt           DateTime             @default(now())
  balance             InventoryBalance     @relation(fields: [balanceId], references: [id], onDelete: Restrict)
  merchant            Merchant             @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  product             Product?             @relation("ProductInventoryMovements", fields: [productId], references: [id], onDelete: Restrict)
  voucherDefinition   VoucherDefinition?   @relation("VoucherInventoryMovements", fields: [voucherDefinitionId], references: [id], onDelete: Restrict)
  order               Order?               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  memberVoucher       MemberVoucher?        @relation(fields: [memberVoucherId], references: [id], onDelete: Restrict)
  actor               User?                @relation("InventoryMovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([merchantId, requestKey])
  @@index([merchantId, createdAt])
  @@index([productId, createdAt])
  @@index([voucherDefinitionId, createdAt])
  @@index([orderId])
  @@index([memberVoucherId])
  @@index([actorId])
}

model OrderVoucherReservation {
  id        Int           @id @default(autoincrement())
  voucherId Int           @unique
  orderId   Int           @unique
  createdAt DateTime      @default(now())
  voucher   MemberVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderRefund {
  id                Int          @id @default(autoincrement())
  orderId           Int          @unique
  status            RefundStatus @default(PENDING_PROVIDER)
  amountVnd         Decimal      @db.Decimal(15, 0)
  reason            String       @db.VarChar(255)
  requestedById     Int
  requestedAt       DateTime     @default(now())
  completedAt       DateTime?
  providerReference String?      @db.VarChar(191)
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy       User         @relation("RefundRequester", fields: [requestedById], references: [id])

  @@index([requestedById])
}

model RewardFulfillment {
  id            Int           @id @default(autoincrement())
  voucherId     Int           @unique
  fulfilledById Int
  fulfilledAt   DateTime      @default(now())
  note          String?       @db.VarChar(255)
  voucher       MemberVoucher @relation(fields: [voucherId], references: [id])
  fulfilledBy   User          @relation("RewardFulfiller", fields: [fulfilledById], references: [id])
}

model RewardCancellation {
  id            Int           @id @default(autoincrement())
  voucherId     Int           @unique
  cancelledById Int
  cancelledAt   DateTime      @default(now())
  reason        String        @db.VarChar(255)
  voucher       MemberVoucher @relation(fields: [voucherId], references: [id])
  cancelledBy   User          @relation("RewardCanceller", fields: [cancelledById], references: [id])

  @@index([cancelledById])
}
