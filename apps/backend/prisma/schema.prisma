generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  MERCHANT
  MEMBER
}

enum AccountStatus {
  ACTIVE
  PENDING_APPROVAL
  REJECTED
  SUSPENDED
  BANNED
}

enum AdminAuditAction {
  USER_STATUS_CHANGED
  EMAIL_BLACKLISTED
  EMAIL_BLACKLIST_DEACTIVATED
  MERCHANT_STATUS_CHANGED
}

enum AdminAuditTargetType {
  USER
  EMAIL_BLACKLIST
  MERCHANT
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  ACTIVE
  HIDDEN
}

enum ProductKind {
  SALE
  REWARD
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum RefundStatus {
  PENDING_PROVIDER
  COMPLETED
  FAILED
}

enum PaymentAttemptStatus {
  CREATED
  SUCCEEDED
  FAILED
}

enum TierLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum PointTransactionType {
  EARN
  REDEEM_DISCOUNT
  REDEEM_REWARD
  EARN_REVERSAL
  REDEMPTION_REVERSAL
}

enum PointTransactionSource {
  MOCK_PAYMENT
  VNPAY_IPN
  MEMBER_REDEMPTION
  MERCHANT_REFUND
  MERCHANT_REWARD_CANCELLATION
  ADMIN_ADJUSTMENT
  LEGACY_BACKFILL
  SYSTEM
  CHALLENGE_REWARD
  CHALLENGE_REFUND
}

enum VoucherType {
  DISCOUNT
  REWARD
}

enum MemberVoucherStatus {
  AVAILABLE
  PENDING_FULFILLMENT
  USED
  FULFILLED
  CANCELLED
}

enum InventoryOwnerType {
  SALE_PRODUCT
  REWARD_PRODUCT
  DISCOUNT_VOUCHER
}

enum InventoryMovementType {
  INITIAL_STOCK
  MANUAL_IN
  MANUAL_OUT
  RETURN_IN
  ORDER_RESERVE
  ORDER_RELEASE
  SALE_OUT
  REWARD_RESERVE
  REWARD_CANCEL_RELEASE
  REWARD_FULFILL_OUT
  REWARD_LEGACY_RESERVE
  VOUCHER_REDEMPTION_OUT
  REDEMPTION_REVERSAL_IN
  LEGACY_BACKFILL
}

enum LoyaltyPolicyVersionSource {
  MERCHANT_PUBLISH
  LEGACY_BACKFILL
}

model User {
  challengeLimitNoticeReads ChallengeLimitNoticeRead[]
  id                               Int                       @id @default(autoincrement())
  email                            String                    @unique @db.VarChar(191)
  passwordHash                     String                    @db.VarChar(255)
  role                             UserRole
  accountStatus                    AccountStatus             @default(ACTIVE)
  createdAt                        DateTime                  @default(now())
  updatedAt                        DateTime                  @updatedAt
  application                      MerchantApplication?      @relation("Applicant")
  reviewedApplications             MerchantApplication[]     @relation("Reviewer")
  merchant                         Merchant?                 @relation("MerchantOwner")
  memberships                      MerchantMembership[]      @relation("MemberMemberships")
  orders                           Order[]                   @relation("MemberOrders")
  fulfilledRewards                 RewardFulfillment[]       @relation("RewardFulfiller")
  cancelledRewards                 RewardCancellation[]      @relation("RewardCanceller")
  refundsRequested                 OrderRefund[]             @relation("RefundRequester")
  abuseReportsFiled                MerchantAbuseReport[]     @relation("AbuseReportReporter")
  abuseReportsReceived             MerchantAbuseReport[]     @relation("AbuseReportMember")
  publishedLoyaltyPolicies         LoyaltyPolicyVersion[]    @relation("LoyaltyPolicyPublisher")
  inventoryMovements               InventoryMovement[]       @relation("InventoryMovementActor")
  updatedStorefrontDrafts          StorefrontDraft[]         @relation("StorefrontDraftUpdater")
  publishedStorefrontVersions      StorefrontConfigVersion[] @relation("StorefrontVersionPublisher")
  refundRequestsAsMember           RefundRequest[]           @relation("RefundMember")
  refundRequestsAsMerchantReviewer RefundRequest[]           @relation("RefundMerchantReviewer")
  refundRequestsAsAdminReviewer    RefundRequest[]           @relation("RefundAdminReviewer")
  refreshSessions                  RefreshSession[]
}

model RefreshSession {
  id           Int             @id @default(autoincrement())
  userId       Int
  familyId     String          @db.Char(36)
  tokenHash    String          @unique @db.Char(64)
  createdAt    DateTime        @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById Int?            @unique
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy   RefreshSession? @relation("RefreshSessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshSession? @relation("RefreshSessionRotation")

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId, revokedAt])
}

model EmailBlacklistEntry {
  id             Int      @id @default(autoincrement())
  email          String   @unique @db.VarChar(191)
  reason         String   @db.VarChar(255)
  isActive       Boolean  @default(true)
  lastActorId    Int
  lastActorEmail String   @db.VarChar(191)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, updatedAt])
}

model AdminAuditLog {
  id         Int                  @id @default(autoincrement())
  actorId    Int
  actorEmail String               @db.VarChar(191)
  action     AdminAuditAction
  targetType AdminAuditTargetType
  targetId   Int
  reason     String               @db.VarChar(255)
  before     Json?
  after      Json?
  createdAt  DateTime             @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
}

model MerchantAbuseReport {
  id         Int      @id @default(autoincrement())
  merchantId Int
  reporterId Int
  memberId   Int
  orderId    Int?
  reason     String   @db.Text
  createdAt  DateTime @default(now())
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  reporter   User     @relation("AbuseReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  member     User     @relation("AbuseReportMember", fields: [memberId], references: [id], onDelete: Restrict)
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([merchantId, createdAt])
  @@index([memberId, createdAt])
  @@index([orderId])
}

model MerchantApplication {
  id           Int               @id @default(autoincrement())
  applicantId  Int               @unique
  storeName    String            @db.VarChar(191)
  slug         String?           @unique @db.VarChar(191)
  status       ApplicationStatus @default(PENDING)
  reviewedById Int?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  applicant    User              @relation("Applicant", fields: [applicantId], references: [id])
  reviewedBy   User?             @relation("Reviewer", fields: [reviewedById], references: [id])

  @@index([status])
}

enum MerchantFeeTier {
  BRONZE
  SILVER
  GOLD
}

enum MerchantFeeType {
  FEE_CHARGE
  FEE_REVERSAL
}

enum StorefrontVersionSource {
  DEFAULT_INIT
  PUBLISH
  ROLLBACK
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

model Merchant {
  id                 Int                       @id @default(autoincrement())
  ownerId            Int                       @unique
  name               String                    @db.VarChar(191)
  slug               String                    @unique @db.VarChar(191)
  isActive           Boolean                   @default(true)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  owner              User                      @relation("MerchantOwner", fields: [ownerId], references: [id])
  products           Product[]
  productCategories  ProductCategory[]
  productImages      ProductImage[]
  orders             Order[]
  memberships        MerchantMembership[]
  tiers              LoyaltyTier[]
  loyaltyRule        LoyaltyRule?
  voucherDefinitions VoucherDefinition[]
  abuseReports       MerchantAbuseReport[]
  policyVersions     LoyaltyPolicyVersion[]
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  feeTier            MerchantFeeTier           @default(BRONZE)
  feeTierYear        Int?
  feeTierEvaluatedAt DateTime?
  feeTransactions    MerchantFeeTransaction[]
  storefrontDraft    StorefrontDraft?
  storefrontVersions StorefrontConfigVersion[]
  events             MerchantEvent[]
  challenges         Challenge[]
  refundRequests     RefundRequest[]
}

model StorefrontDraft {
  id          Int      @id @default(autoincrement())
  merchantId  Int      @unique
  config      Json
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("StorefrontDraftUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model StorefrontConfigVersion {
  id              Int                     @id @default(autoincrement())
  merchantId      Int
  version         Int
  config          Json
  isPublished     Boolean                 @default(false)
  source          StorefrontVersionSource @default(PUBLISH)
  sourceVersionId Int?
  note            String?                 @db.VarChar(255)
  publishedById   Int?
  publishedAt     DateTime                @default(now())
  merchant        Merchant                @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  publishedBy     User?                   @relation("StorefrontVersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([merchantId, version])
  @@index([merchantId, isPublished])
  @@index([merchantId, publishedAt])
  @@index([publishedById])
}

model ProductCategory {
  id          Int       @id @default(autoincrement())
  merchantId  Int
  name        String    @db.VarChar(100)
  slug        String    @db.VarChar(120)
  description String?   @db.VarChar(255)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  products    Product[]

  @@unique([merchantId, slug])
  @@unique([merchantId, name])
  @@index([merchantId, sortOrder])
}

model Product {
  id                       Int                 @id @default(autoincrement())
  merchantId               Int
  categoryId               Int?
  sku                      String?             @db.VarChar(64)
  name                     String              @db.VarChar(191)
  description              String?             @db.Text
  richDescription          String?             @db.Text
  price                    Decimal             @db.Decimal(15, 0)
  imageUrl                 String?             @db.VarChar(2048)
  lowStockThreshold        Int                 @default(5)
  status                   ProductStatus       @default(ACTIVE)
  kind                     ProductKind         @default(SALE)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  merchant                 Merchant            @relation(fields: [merchantId], references: [id])
  category                 ProductCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images                   ProductImage[]
  orderItems               OrderItem[]
  rewardVoucherDefinitions VoucherDefinition[]
  rewardVoucherSnapshots   MemberVoucher[]     @relation("RewardProductSnapshot")
  inventoryBalance         InventoryBalance?
  inventoryMovements       InventoryMovement[] @relation("ProductInventoryMovements")

  @@unique([merchantId, sku])
  @@index([merchantId, status])
  @@index([merchantId, categoryId, status])
}

model ProductImage {
  id         Int      @id @default(autoincrement())
  productId  Int
  merchantId Int
  url        String   @db.VarChar(2048)
  altText    String?  @db.VarChar(191)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([productId, sortOrder])
  @@index([merchantId, productId])
}

model MerchantEvent {
  id              Int         @id @default(autoincrement())
  merchantId      Int
  title           String      @db.VarChar(191)
  slug            String      @db.VarChar(191)
  description     String      @db.Text
  bannerUrl       String?     @db.VarChar(2048)
  startAt         DateTime
  endAt           DateTime
  locationName    String      @db.VarChar(191)
  locationAddress String?     @db.VarChar(500)
  status          EventStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  merchant        Merchant    @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@unique([merchantId, slug])
  @@index([merchantId, status, startAt])
}

model Order {
  id                     Int                      @id @default(autoincrement())
  merchantId             Int
  memberId               Int
  status                 OrderStatus              @default(PENDING)
  subtotal               Decimal                  @db.Decimal(15, 0)
  discountAmount         Decimal                  @default(0) @db.Decimal(15, 0)
  total                  Decimal                  @db.Decimal(15, 0)
  voucherId              Int?
  earnedPointsExact      Decimal?                 @db.Decimal(38, 12)
  loyaltySnapshot        Json?
  loyaltyPolicyVersionId Int?
  stockReservedAt        DateTime?
  stockReservedUntil     DateTime?
  stockReleasedAt        DateTime?
  paidAt                 DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  merchant               Merchant                 @relation(fields: [merchantId], references: [id])
  member                 User                     @relation("MemberOrders", fields: [memberId], references: [id])
  voucher                MemberVoucher?           @relation("AppliedVoucher", fields: [voucherId], references: [id])
  items                  OrderItem[]
  pointTransactions      PointTransaction[]
  paymentAttempt         PaymentAttempt?
  voucherReservation     OrderVoucherReservation?
  refund                 OrderRefund?
  abuseReports           MerchantAbuseReport[]
  activities             MemberActivity[]
  loyaltyPolicyVersion   LoyaltyPolicyVersion?    @relation(fields: [loyaltyPolicyVersionId], references: [id], onDelete: Restrict)
  inventoryMovements     InventoryMovement[]
  feeTransactions        MerchantFeeTransaction[]
  refundRequest          RefundRequest?

  @@index([merchantId, status])
  @@index([merchantId, status, paidAt])
  @@index([merchantId, memberId, status])
  @@index([memberId, createdAt])
  @@index([voucherId])
  @@index([merchantId, status, stockReservedUntil])
  @@index([loyaltyPolicyVersionId])
}

model MerchantFeeTransaction {
  id            Int             @id @default(autoincrement())
  merchantId    Int
  orderId       Int
  type          MerchantFeeType
  amountVnd     Decimal         @db.Decimal(15, 0)
  orderTotalVnd Decimal         @db.Decimal(15, 0)
  tier          MerchantFeeTier
  feeRate       Decimal         @db.Decimal(5, 4)
  createdAt     DateTime        @default(now())
  eventRef      String          @unique @db.VarChar(191)
  merchant      Merchant        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, type])
  @@index([merchantId, createdAt])
  @@index([createdAt])
}

model PaymentAttempt {
  id                            Int                  @id @default(autoincrement())
  orderId                       Int                  @unique
  txnRef                        String               @unique @db.VarChar(100)
  expectedAmount                Decimal              @db.Decimal(15, 0)
  reservedPoints                Decimal              @default(0) @db.Decimal(38, 12)
  snapshotTierLevel             TierLevel?
  snapshotMultiplier            Decimal?             @db.Decimal(5, 2)
  snapshotPolicy                Json?
  snapshotVndPerPoint           Int                  @default(10000)
  snapshotRuleActive            Boolean              @default(true)
  snapshotMaxMultiplier         Decimal              @default(2.00) @db.Decimal(5, 2)
  snapshotTierConfigFallback    Boolean              @default(false)
  snapshotExactReservationAward Boolean              @default(false)
  snapshotBronzeMultiplier      Decimal              @default(1.00) @db.Decimal(5, 2)
  snapshotSilverMultiplier      Decimal              @default(1.20) @db.Decimal(5, 2)
  snapshotGoldMultiplier        Decimal              @default(1.50) @db.Decimal(5, 2)
  snapshotPlatinumMultiplier    Decimal              @default(2.00) @db.Decimal(5, 2)
  status                        PaymentAttemptStatus @default(CREATED)
  transactionNo                 String?              @db.VarChar(64)
  createdAt                     DateTime             @default(now())
  confirmedAt                   DateTime?
  order                         Order                @relation(fields: [orderId], references: [id])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   Int
  productName String  @db.VarChar(191)
  unitPrice   Decimal @db.Decimal(15, 0)
  quantity    Int
  lineTotal   Decimal @db.Decimal(15, 0)
  order       Order   @relation(fields: [orderId], references: [id])
  product     Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model MerchantMembership {
  id                Int                 @id @default(autoincrement())
  merchantId        Int
  memberId          Int
  tierId            Int?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  merchant          Merchant            @relation(fields: [merchantId], references: [id])
  member            User                @relation("MemberMemberships", fields: [memberId], references: [id])
  tier              LoyaltyTier?        @relation(fields: [tierId], references: [id])
  wallet            LoyaltyWallet?
  vouchers          MemberVoucher[]
  activities        MemberActivity[]
  challengeProgress ChallengeProgress[]

  @@unique([memberId, merchantId])
  @@index([merchantId])
  @@index([tierId])
}

model LoyaltyTier {
  id                Int                  @id @default(autoincrement())
  merchantId        Int
  level             TierLevel
  minLifetimePoints Int
  multiplier        Decimal              @db.Decimal(5, 2)
  merchant          Merchant             @relation(fields: [merchantId], references: [id])
  memberships       MerchantMembership[]

  @@unique([merchantId, level])
  @@unique([merchantId, minLifetimePoints])
}

model LoyaltyRule {
  id          Int      @id @default(autoincrement())
  merchantId  Int      @unique
  vndPerPoint Int      @default(10000)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  merchant    Merchant @relation(fields: [merchantId], references: [id])
}

model LoyaltyPolicyVersion {
  id            Int                        @id @default(autoincrement())
  merchantId    Int
  version       Int
  vndPerPoint   Int
  isActive      Boolean
  tiers         Json
  source        LoyaltyPolicyVersionSource @default(MERCHANT_PUBLISH)
  publishedById Int?
  publishedAt   DateTime                   @default(now())
  merchant      Merchant                   @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  publishedBy   User?                      @relation("LoyaltyPolicyPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  orders        Order[]

  @@unique([merchantId, version])
  @@index([merchantId, publishedAt])
  @@index([publishedById])
}

model LoyaltyWallet {
  id                Int                @id @default(autoincrement())
  membershipId      Int                @unique
  exactBalance      Decimal            @default(0) @db.Decimal(38, 12)
  netLifetimeEarned Decimal            @default(0) @db.Decimal(38, 12)
  reservedPoints    Decimal            @default(0) @db.Decimal(38, 12)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  membership        MerchantMembership @relation(fields: [membershipId], references: [id])
  transactions      PointTransaction[]
}

model PointTransaction {
  id                Int                    @id @default(autoincrement())
  walletId          Int
  type              PointTransactionType
  delta             Decimal                @db.Decimal(38, 12)
  balanceAfter      Decimal                @db.Decimal(38, 12)
  promotedToTier    TierLevel?
  reason            String                 @db.VarChar(255)
  eventRef          String                 @unique @default(uuid()) @db.VarChar(191)
  source            PointTransactionSource @default(LEGACY_BACKFILL)
  actorId           Int?
  orderId           Int?
  memberVoucherId   Int?
  createdAt         DateTime               @default(now())
  wallet            LoyaltyWallet          @relation(fields: [walletId], references: [id])
  order             Order?                 @relation(fields: [orderId], references: [id])
  challengeGrant    ChallengeRewardGrant?  @relation("ChallengeGrantEarn")
  challengeReversal ChallengeRewardGrant?  @relation("ChallengeGrantReversal")
  memberVoucher     MemberVoucher?         @relation(fields: [memberVoucherId], references: [id])

  @@index([walletId, createdAt])
  @@index([orderId])
  @@index([memberVoucherId])
  @@index([actorId])
}

model RedemptionIdempotency {
  id             Int      @id @default(autoincrement())
  memberId       Int
  route          String   @db.VarChar(191)
  idempotencyKey String   @db.VarChar(128)
  requestHash    String   @db.VarChar(64)
  definitionId   Int
  voucherId      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([memberId, route, idempotencyKey])
  @@index([memberId])
  @@index([voucherId])
}

model VoucherDefinition {
  id                 Int                 @id @default(autoincrement())
  merchantId         Int
  type               VoucherType
  title              String              @db.VarChar(191)
  pointsCost         Int
  discountAmount     Decimal?            @db.Decimal(15, 0)
  rewardDescription  String?             @db.Text
  rewardProductId    Int?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  merchant           Merchant            @relation(fields: [merchantId], references: [id])
  rewardProduct      Product?            @relation(fields: [rewardProductId], references: [id], onDelete: Restrict)
  memberVouchers     MemberVoucher[]
  inventoryBalance   InventoryBalance?
  inventoryMovements InventoryMovement[] @relation("VoucherInventoryMovements")

  @@index([merchantId, type, isActive])
  @@index([rewardProductId])
}

model MemberVoucher {
  id                        Int                      @id @default(autoincrement())
  membershipId              Int
  definitionId              Int
  snapshotType              VoucherType
  snapshotTitle             String                   @db.VarChar(191)
  snapshotPointsCost        Int
  snapshotDiscountAmount    Decimal?                 @db.Decimal(15, 0)
  snapshotRewardDescription String?                  @db.Text
  rewardProductIdSnapshot   Int?
  rewardInventoryReserved   Boolean                  @default(false)
  status                    MemberVoucherStatus      @default(AVAILABLE)
  redeemedAt                DateTime                 @default(now())
  usedAt                    DateTime?
  membership                MerchantMembership       @relation(fields: [membershipId], references: [id])
  definition                VoucherDefinition        @relation(fields: [definitionId], references: [id])
  appliedOrders             Order[]                  @relation("AppliedVoucher")
  activeReservation         OrderVoucherReservation?
  pointTransactions         PointTransaction[]
  fulfillment               RewardFulfillment?
  cancellation              RewardCancellation?
  rewardProduct             Product?                 @relation("RewardProductSnapshot", fields: [rewardProductIdSnapshot], references: [id], onDelete: Restrict)
  inventoryMovements        InventoryMovement[]

  @@index([membershipId, status])
  @@index([definitionId])
}

model InventoryBalance {
  id                  Int                 @id @default(autoincrement())
  merchantId          Int
  ownerType           InventoryOwnerType
  productId           Int?                @unique
  voucherDefinitionId Int?                @unique
  onHandQuantity      Int                 @default(0)
  reservedQuantity    Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  merchant            Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  product             Product?            @relation(fields: [productId], references: [id], onDelete: Restrict)
  voucherDefinition   VoucherDefinition?  @relation(fields: [voucherDefinitionId], references: [id], onDelete: Restrict)
  movements           InventoryMovement[]

  @@index([merchantId, ownerType])
}

model InventoryMovement {
  id                  Int                   @id @default(autoincrement())
  balanceId           Int
  merchantId          Int
  ownerType           InventoryOwnerType
  movementType        InventoryMovementType
  quantityDelta       Int
  onHandBefore        Int
  onHandAfter         Int
  reservedBefore      Int
  reservedAfter       Int
  productId           Int?
  voucherDefinitionId Int?
  orderId             Int?
  memberVoucherId     Int?
  actorId             Int?
  reason              String                @db.VarChar(255)
  eventRef            String                @unique @db.VarChar(191)
  requestKey          String?               @db.VarChar(128)
  createdAt           DateTime              @default(now())
  balance             InventoryBalance      @relation(fields: [balanceId], references: [id], onDelete: Restrict)
  merchant            Merchant              @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  product             Product?              @relation("ProductInventoryMovements", fields: [productId], references: [id], onDelete: Restrict)
  voucherDefinition   VoucherDefinition?    @relation("VoucherInventoryMovements", fields: [voucherDefinitionId], references: [id], onDelete: Restrict)
  order               Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  memberVoucher       MemberVoucher?        @relation(fields: [memberVoucherId], references: [id], onDelete: Restrict)
  actor               User?                 @relation("InventoryMovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([merchantId, requestKey])
  @@index([merchantId, createdAt])
  @@index([productId, createdAt])
  @@index([voucherDefinitionId, createdAt])
  @@index([orderId])
  @@index([memberVoucherId])
  @@index([actorId])
}

model OrderVoucherReservation {
  id        Int           @id @default(autoincrement())
  voucherId Int           @unique
  orderId   Int           @unique
  createdAt DateTime      @default(now())
  voucher   MemberVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderRefund {
  id                Int          @id @default(autoincrement())
  orderId           Int          @unique
  status            RefundStatus @default(PENDING_PROVIDER)
  amountVnd         Decimal      @db.Decimal(15, 0)
  reason            String       @db.VarChar(255)
  requestedById     Int
  requestedAt       DateTime     @default(now())
  completedAt       DateTime?
  providerReference String?      @db.VarChar(191)
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy       User         @relation("RefundRequester", fields: [requestedById], references: [id])

  @@index([requestedById])
}

model RewardFulfillment {
  id            Int           @id @default(autoincrement())
  voucherId     Int           @unique
  fulfilledById Int
  fulfilledAt   DateTime      @default(now())
  note          String?       @db.VarChar(255)
  voucher       MemberVoucher @relation(fields: [voucherId], references: [id])
  fulfilledBy   User          @relation("RewardFulfiller", fields: [fulfilledById], references: [id])
}

model RewardCancellation {
  id            Int           @id @default(autoincrement())
  voucherId     Int           @unique
  cancelledById Int
  cancelledAt   DateTime      @default(now())
  reason        String        @db.VarChar(255)
  voucher       MemberVoucher @relation(fields: [voucherId], references: [id])
  cancelledBy   User          @relation("RewardCanceller", fields: [cancelledById], references: [id])

  @@index([cancelledById])
}

enum ChallengeType {
  ORDER_COUNT
  DAILY_CHECKIN
  SPEND_TOTAL
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MemberActivityType {
  ORDER_PAID
  DAILY_CHECKIN
  ORDER_REFUNDED
}

enum ChallengeRewardState {
  IN_PROGRESS
  WAITING_BUDGET
  REWARDED
  LIMIT_REACHED
}

enum ChallengeRewardGrantStatus {
  GRANTED
  REVERSED
}

enum RefundRequestStatus {
  PENDING_MERCHANT
  PENDING_ADMIN
  REJECTED
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
}

model Challenge {
  id           Int                 @id @default(autoincrement())
  merchantId   Int
  title        String              @db.VarChar(191)
  description  String              @db.Text
  type         ChallengeType
  status       ChallengeStatus     @default(DRAFT)
  targetValue  Decimal             @db.Decimal(15, 0)
  rewardPoints Decimal             @db.Decimal(38, 12)
  budgetTotal  Decimal             @db.Decimal(38, 12)
  budgetSpent  Decimal             @default(0) @db.Decimal(38, 12)
  maxRewardRecipients Int?
  rewardSlotsClaimed  Int           @default(0)
  startsAt     DateTime
  endsAt       DateTime
  isFeatured   Boolean             @default(false)
  activatedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  merchant     Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  progresses   ChallengeProgress[]
  milestones   ChallengeMilestone[]
  limitNotices ChallengeLimitNotice[]

  @@index([merchantId, status, startsAt])
  @@index([merchantId, type])
}

model ChallengeLimitNotice {
  id          Int       @id @default(autoincrement())
  challengeId Int?
  title       String    @db.VarChar(191)
  previousLimit Int
  newLimit    Int
  actorId     Int
  createdAt   DateTime  @default(now())
  challenge   Challenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  reads       ChallengeLimitNoticeRead[]

  @@index([challengeId, id])
}

model ChallengeLimitNoticeRead {
  noticeId Int
  memberId Int
  notice   ChallengeLimitNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  member   User @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([memberId, noticeId])
  @@index([noticeId])
}

model ChallengeMilestone {
  id             Int       @id @default(autoincrement())
  challengeId    Int
  position       Int
  thresholdValue Decimal   @db.Decimal(15, 0)
  title          String    @db.VarChar(80)
  description    String    @db.VarChar(240)
  challenge      Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, position])
  @@unique([challengeId, thresholdValue])
}

model MemberActivity {
  id           Int                      @id @default(autoincrement())
  membershipId Int
  type         MemberActivityType
  eventKey     String                   @unique @db.VarChar(191)
  orderId      Int?
  amountVnd    Decimal?                 @db.Decimal(15, 0)
  occurredAt   DateTime
  createdAt    DateTime                 @default(now())
  membership   MerchantMembership       @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  order        Order?                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  entries      ChallengeProgressEntry[]

  @@index([membershipId, type, occurredAt])
  @@index([orderId])
}

model ChallengeProgress {
  id           Int                      @id @default(autoincrement())
  challengeId  Int
  membershipId Int
  currentValue Decimal                  @default(0) @db.Decimal(15, 0)
  rewardState  ChallengeRewardState     @default(IN_PROGRESS)
  rewardCycle  Int                      @default(1)
  rewardSlotClaimed Boolean             @default(false)
  completedAt  DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  challenge    Challenge                @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  membership   MerchantMembership       @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  entries      ChallengeProgressEntry[]
  grants       ChallengeRewardGrant[]

  @@unique([challengeId, membershipId])
  @@index([challengeId, rewardState, completedAt])
}

model ChallengeProgressEntry {
  id         Int               @id @default(autoincrement())
  progressId Int
  activityId Int
  deltaValue Decimal           @db.Decimal(15, 0)
  createdAt  DateTime          @default(now())
  progress   ChallengeProgress @relation(fields: [progressId], references: [id], onDelete: Restrict)
  activity   MemberActivity    @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@unique([progressId, activityId])
  @@index([activityId])
}

model ChallengeRewardGrant {
  id                    Int                        @id @default(autoincrement())
  progressId            Int
  cycle                 Int
  status                ChallengeRewardGrantStatus @default(GRANTED)
  pointsGranted         Decimal                    @db.Decimal(38, 12)
  earnTransactionId     Int                        @unique
  reversalTransactionId Int?                       @unique
  grantedAt             DateTime                   @default(now())
  reversedAt            DateTime?
  progress              ChallengeProgress          @relation(fields: [progressId], references: [id], onDelete: Restrict)
  earnTransaction       PointTransaction           @relation("ChallengeGrantEarn", fields: [earnTransactionId], references: [id], onDelete: Restrict)
  reversalTransaction   PointTransaction?          @relation("ChallengeGrantReversal", fields: [reversalTransactionId], references: [id], onDelete: Restrict)

  @@unique([progressId, cycle])
}

model RefundRequest {
  id                     Int                 @id @default(autoincrement())
  orderId                Int                 @unique
  memberId               Int
  merchantId             Int
  reason                 String              @db.VarChar(255)
  status                 RefundRequestStatus @default(PENDING_MERCHANT)
  requestedAt            DateTime            @default(now())
  merchantReviewedById   Int?
  merchantReviewedAt     DateTime?
  merchantDecisionReason String?             @db.VarChar(255)
  adminReviewedById      Int?
  adminReviewedAt        DateTime?
  adminDecisionReason    String?             @db.VarChar(255)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  order                  Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  member                 User                @relation("RefundMember", fields: [memberId], references: [id], onDelete: Restrict)
  merchant               Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  merchantReviewer       User?               @relation("RefundMerchantReviewer", fields: [merchantReviewedById], references: [id], onDelete: SetNull)
  adminReviewer          User?               @relation("RefundAdminReviewer", fields: [adminReviewedById], references: [id], onDelete: SetNull)

  @@index([merchantId, status, requestedAt])
  @@index([status, requestedAt])
}
