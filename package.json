{
  "name": "incomsg",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace apps/frontend",
    "dev:backend": "npm run dev --workspace apps/backend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:frontend": "npm test --workspace apps/frontend",
    "test:backend": "npm test --workspace apps/backend",
    "test:db": "node scripts/test-backend-db.mjs",
    "demo:backend": "node scripts/loyalty-demo.mjs serve",
    "demo:frontend": "node scripts/loyalty-demo.mjs frontend",
    "demo:seed": "node scripts/loyalty-demo.mjs seed",
    "demo:verify": "node scripts/loyalty-demo.mjs verify",
    "test:e2e": "playwright test --config tests/frontend/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
